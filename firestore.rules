rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return isSignedIn() && exists(userDocPath());
    }

    function userData() {
      return get(userDocPath()).data;
    }

    function isPlatformAdmin() {
      return userExists() && userData().globalRole == 'platform_admin';
    }

    function churchDocPath(churchId) {
      return /databases/$(database)/documents/churches/$(churchId);
    }

    function churchExists(churchId) {
      return exists(churchDocPath(churchId));
    }

    function memberDocPath(churchId) {
      return /databases/$(database)/documents/churches/$(churchId)/members/$(request.auth.uid);
    }

    function memberExists(churchId) {
      return isSignedIn() && exists(memberDocPath(churchId));
    }

    function memberData(churchId) {
      return get(memberDocPath(churchId)).data;
    }

    function belongsToChurch(churchId) {
      return memberExists(churchId)
        && memberData(churchId).status == 'active';
    }

    function roleInChurch(churchId) {
      return memberData(churchId).role;
    }

    function isChurchAdmin(churchId) {
      return isPlatformAdmin()
        || (isVerified()
          && belongsToChurch(churchId)
          && roleInChurch(churchId) == 'church_admin');
    }

    function isTeacher(churchId) {
      return belongsToChurch(churchId) && roleInChurch(churchId) == 'teacher';
    }

    function isVolunteer(churchId) {
      return belongsToChurch(churchId) && roleInChurch(churchId) == 'volunteer';
    }

    function canReadChurch(churchId) {
      return isPlatformAdmin() || belongsToChurch(churchId);
    }

    function canManageChurch(churchId) {
      return isChurchAdmin(churchId);
    }

    function canWriteOperationalData(churchId) {
      return canManageChurch(churchId)
        || isTeacher(churchId)
        || isVolunteer(churchId);
    }

    function isBootstrapChurchCreator(churchId) {
      return isSignedIn()
        && churchExists(churchId)
        && get(churchDocPath(churchId)).data.createdByUserId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isPlatformAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isPlatformAdmin());
      allow delete: if isPlatformAdmin();
    }

    match /churchCodes/{churchCode} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.createdByUserId == request.auth.uid
        && request.resource.data.churchId is string;
      allow update, delete: if isPlatformAdmin()
        || (resource.data.churchId is string && canManageChurch(resource.data.churchId));
    }

    match /churches/{churchId} {
      allow read: if canReadChurch(churchId);
      allow create: if isSignedIn()
        && request.resource.data.createdByUserId == request.auth.uid
        && request.resource.data.slug == churchId;
      allow update, delete: if canManageChurch(churchId);

      match /members/{userId} {
        allow read: if isPlatformAdmin()
          || (isSignedIn() && request.auth.uid == userId)
          || canManageChurch(churchId);

        allow create: if isPlatformAdmin()
          || canManageChurch(churchId)
          || (
            isBootstrapChurchCreator(churchId)
            && request.auth.uid == userId
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.churchId == churchId
            && request.resource.data.role == 'church_admin'
            && request.resource.data.status == 'active'
          );

        allow update, delete: if isPlatformAdmin() || canManageChurch(churchId);
      }

      match /provisioningMembers/{provisioningId} {
        allow read, create, update, delete: if canManageChurch(churchId);
      }

      match /settings/{docId} {
        allow read: if canReadChurch(churchId);
        allow create: if isPlatformAdmin()
          || canManageChurch(churchId)
          || isBootstrapChurchCreator(churchId);
        allow update, delete: if isPlatformAdmin() || canManageChurch(churchId);
      }

      match /centers/{centerId} {
        allow read: if canReadChurch(churchId);
        allow create: if isPlatformAdmin()
          || canManageChurch(churchId)
          || isBootstrapChurchCreator(churchId);
        allow update, delete: if isPlatformAdmin() || canManageChurch(churchId);
      }

      match /students/{studentId} {
        allow read: if canReadChurch(churchId);
        allow create, update: if canWriteOperationalData(churchId);
        allow delete: if canManageChurch(churchId);
      }

      match /parents/{parentId} {
        allow read: if canReadChurch(churchId);
        allow create, update: if canWriteOperationalData(churchId);
        allow delete: if canManageChurch(churchId);
      }

      match /attendanceSessions/{sessionId} {
        allow read: if canReadChurch(churchId);
        allow create, update: if canWriteOperationalData(churchId);
        allow delete: if canManageChurch(churchId);
      }

      match /attendanceRecords/{recordId} {
        allow read: if canReadChurch(churchId);
        allow create, update: if canWriteOperationalData(churchId);
        allow delete: if canManageChurch(churchId);
      }

      match /announcements/{announcementId} {
        allow read: if canReadChurch(churchId);
        allow create, update, delete: if canManageChurch(churchId);
      }

      match /events/{eventId} {
        allow read: if canReadChurch(churchId);
        allow create, update, delete: if canManageChurch(churchId);
      }

      match /followUps/{followUpId} {
        allow read: if canReadChurch(churchId);
        allow create, update: if canWriteOperationalData(churchId);
        allow delete: if canManageChurch(churchId);
      }

      match /spotlight/{docId} {
        allow read: if canReadChurch(churchId);
        allow create, update, delete: if canManageChurch(churchId);
      }
    }
  }
}
